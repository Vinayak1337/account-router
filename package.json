{
  "name": "account-router",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Local account routing for Codex on Windows and macOS",
  "author": "Vinayak1337",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "bin": {
    "account-router": "bin/account-router.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "start:server": "node router.mjs",
    "router": "node bin/account-router.mjs",
    "preview": "node dev/preview.mjs",
    "test": "node --test router.test.mjs desktop/*.test.mjs dev/live-preview.test.mjs",
    "build:win": "electron-builder --win nsis",
    "preview:live": "node dev/live-preview.mjs"
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9"
  },
  "build": {
    "appId": "io.github.vinayak1337.account-router",
    "productName": "Account Router",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/data-root.cjs",
      "dashboard/**",
      "router.mjs",
      "dashboard-api.mjs",
      "account-benefits.mjs",
      "drain-use.mjs",
      "model-routing.mjs",
      "recurring-use.mjs",
      "free-sol-routing.mjs",
      "codex-integration.mjs",
      "package.json",
      "desktop/connection.mjs",
      "desktop/login.mjs",
      "desktop/icon.png",
      "desktop/icon.ico",
      "desktop/tray.png"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Account-Router-${version}-Setup.exe",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico"
    }
  }
}
